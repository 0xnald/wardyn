# Optional server-only AI policy extraction credentials.
WARDYN_AI_API_KEY=
WARDYN_AI_MODEL=
# Enable read-only official Binance CLI access after installation and authentication.
WARDYN_BINANCE_READ_ENABLED=
WARDYN_BINANCE_CLI_PATH=
# Windows only: call the official Linux binary through this WSL distribution.
WARDYN_BINANCE_CLI_WSL_DISTRO=
# Optional absolute Linux path when the CLI is not installed for WSL root.
WARDYN_BINANCE_CLI_WSL_PATH=/root/.cargo/bin/binance-cli
WARDYN_BINANCE_PROFILE=
# Keep false for Monitor Only. Enabling this permits confirmed Spot market sells.
WARDYN_BINANCE_EXECUTION_ENABLED=false
# Comma-separated Spot assets Wardyn may sell, for example BTC,BNB,SOL.
WARDYN_BINANCE_EXECUTION_ASSETS=
# Independent hard ceiling per order. Defaults to 100 when omitted.
WARDYN_BINANCE_MAX_ORDER_USDT=100
# Hosted backend controls. Use a random access code of at least 16 characters.
WARDYN_REMOTE_BINANCE_ENABLED=false
WARDYN_ACCESS_CODE=
WARDYN_ALLOWED_ORIGIN=
# Persistent Railway volume mount, for example /data/wardyn.
WARDYN_DATA_DIR=
# Frontend build setting: Railway backend origin used by the Vercel rewrite.
WARDYN_BACKEND_URL=
# Official CLI authentication (or use a locally configured CLI profile).
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_API_ENV=
